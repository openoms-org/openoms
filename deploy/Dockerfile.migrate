# Build migrate from source with current Go toolchain to avoid CVEs
# in the prebuilt migrate/migrate image (old Go stdlib + Alpine deps).
FROM golang:1.25-alpine AS builder

RUN go install -tags 'postgres' github.com/golang-migrate/migrate/v4/cmd/migrate@v4.19.1

# Minimal runtime — no shell, no package manager, no CVEs
FROM gcr.io/distroless/static-debian12

COPY --from=builder /go/bin/migrate /migrate
COPY apps/api-server/migrations/ /migrations/

ENTRYPOINT ["/migrate"]
